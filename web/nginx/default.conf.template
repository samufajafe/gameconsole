# Sirve la consola y hace de proxy TRANSPARENTE hacia GameStats y Prolog en el mismo origen.
#
# GameStats (P1) no manda cabeceras CORS y no se modifica, asi que el navegador no puede llamarlo
# desde otro origen. Este proxy solo reenvia: no transforma ni cachea nada. El panel sigue
# consultando los endpoints de GameStats tal cual (/metrics, /results/...).
#
# La imagen oficial de nginx sustituye ${INGEST_URL}, ${ANALYTICS_URL}, ${PROLOG_URL} y
# ${NGINX_RESOLVER} al arrancar (solo variables de entorno definidas; las de nginx como $uri quedan
# intactas).

server {
    listen 80;
    root /usr/share/nginx/html;

    # Los backends se resuelven en cada peticion con el DNS de Docker y no al arrancar: asi nginx
    # arranca aunque un servicio no este, y si un contenedor vuelve con otra IP se sigue llegando.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    # Si un backend no responde, que el navegador se entere rapido y el emisor reintente.
    proxy_connect_timeout 3s;
    proxy_read_timeout 10s;
    proxy_send_timeout 10s;

    # Con proxy_pass sobre una variable nginx no recorta el prefijo solo: lo hace el rewrite.
    location /gamestats/ingest/ {
        set $ingest_upstream ${INGEST_URL};
        rewrite ^/gamestats/ingest/(.*)$ /$1 break;
        proxy_pass $ingest_upstream;
    }

    location /gamestats/analytics/ {
        set $analytics_upstream ${ANALYTICS_URL};
        rewrite ^/gamestats/analytics/(.*)$ /$1 break;
        proxy_pass $analytics_upstream;
        add_header Cache-Control "no-store" always;
    }

    location /prolog/ {
        set $prolog_upstream ${PROLOG_URL};
        rewrite ^/prolog/(.*)$ /$1 break;
        proxy_pass $prolog_upstream;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
